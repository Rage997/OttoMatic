# Run after linking so these revisions identify the delivered bytes, not source timestamps.
set(HTML_PATH "${WEB_OUTPUT_DIR}/${GAME_TARGET}.html")
file(READ "${HTML_PATH}" HTML)
file(SHA256 "${WEB_OUTPUT_DIR}/${GAME_TARGET}.js" JS_HASH)
file(SHA256 "${WEB_OUTPUT_DIR}/${GAME_TARGET}.wasm" WASM_HASH)

set(JS_PATTERN "src=[\"']?${GAME_TARGET}\\.js(\\?v=[0-9a-f]+)?[\"']?")
set(WASM_PATTERN "${GAME_TARGET}\\.wasm\\?v=(__OTTO_WASM_VERSION__|[0-9a-f]+)")
foreach(PATTERN IN ITEMS JS_PATTERN WASM_PATTERN)
	string(REGEX MATCHALL "${${PATTERN}}" MATCHES "${HTML}")
	list(LENGTH MATCHES COUNT)
	if(NOT COUNT EQUAL 1)
		message(FATAL_ERROR "Expected one ${PATTERN} in ${HTML_PATH}; found ${COUNT}")
	endif()
endforeach()
string(REGEX REPLACE "${JS_PATTERN}" "src=\"${GAME_TARGET}.js?v=${JS_HASH}\"" HTML "${HTML}")
string(REGEX REPLACE "${WASM_PATTERN}" "${GAME_TARGET}.wasm?v=${WASM_HASH}" HTML "${HTML}")
if(HTML MATCHES "__OTTO_[A-Z_]+__")
	message(FATAL_ERROR "Unresolved asset revision in ${HTML_PATH}")
endif()
file(WRITE "${HTML_PATH}" "${HTML}")
